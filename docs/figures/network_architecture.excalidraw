      "isDeleted": true,
      "boundElements": [],
      "updated": 1786888219819,
      "link": null,
      "locked": false,
      "text": "그럼 지금 확실하게 쓸 수 있는 근거는 뭐냐",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "그럼 지금 확실하게 쓸 수 있는 근거는 뭐냐",
      "autoResize": true,
      "lineHeight": 1.25
    },
