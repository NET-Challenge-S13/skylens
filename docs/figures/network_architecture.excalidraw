    {
      "id": "BWML-t6DfDC3GdUDywAUT",
      "type": "text",
      "x": 319.1911392565014,
      "y": 2789.526462758018,
      "width": 640.6598510742188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
