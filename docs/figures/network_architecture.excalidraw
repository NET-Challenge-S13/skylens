    {
      "id": "LBrCAfM71FLvzxjMPillS",
      "type": "text",
      "x": -7144.831987042382,
      "y": -1977.5850710801458,
      "width": 170.4998779296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
