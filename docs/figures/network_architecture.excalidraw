    {
      "id": "qnCnLZVCYPB1r7gm4aw7u",
      "type": "text",
      "x": 239.92121127798578,
      "y": 2542.026462758018,
      "width": 799.19970703125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
