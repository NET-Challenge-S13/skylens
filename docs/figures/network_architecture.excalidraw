    {
      "id": "7hFcHw8LsNyCU4tyrLzVV",
      "type": "text",
      "x": -5839.524470211929,
      "y": -2125.234318346441,
      "width": 206.39990234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
