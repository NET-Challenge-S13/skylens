{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyLens Drone",
  "version": "1.0.0",
  "identifier": "kr.skylens.drone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/src/skylens_drone/index.html",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkyLens · 드론 운용 패널",
        "width": 1180,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
