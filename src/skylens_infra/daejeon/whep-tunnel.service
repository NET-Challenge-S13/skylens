# 대전 → 브리지 SSH 리버스 터널 (autossh, 상시 유지)
#
# 브리지 로컬 :20889 → 대전 :10889 (MediaMTX WHEP)
# 브리지→대전 인바운드가 막혀 있으므로 대전이 먼저 나가서 통로를 연다.
#
# 설정값은 /etc/default/whep-tunnel 에서 읽는다 (BRIDGE_HOST, BRIDGE_PORT, BRIDGE_USER).
# 설치:
#   sudo install -m 0644 whep-tunnel.service /etc/systemd/system/
#   sudo install -m 0600 whep-tunnel.env /etc/default/whep-tunnel   (값 채운 뒤)
#   sudo systemctl enable --now whep-tunnel

[Unit]
Description=SSH reverse tunnel Daejeon -> bridge for WHEP signaling (SkyLens)
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
User=ubuntu
EnvironmentFile=/etc/default/whep-tunnel
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N \
  -i /home/ubuntu/.ssh/id_tunnel \
  -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -R 20889:127.0.0.1:10889 \
  -p ${BRIDGE_PORT} ${BRIDGE_USER}@${BRIDGE_HOST}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
