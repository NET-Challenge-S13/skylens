# Copy to bridge.env and fill in. Empty means the default.
#
# The HTTP port browsers connect to (nginx). Change it if 80 is taken.
HTTP_PORT=80
#
# The password the drone gateway uses to publish its SRT feed.
# Left empty, the installer makes a random one and prints it.
PUBLISH_PASS=
#
# SRT ingest port (UDP). Behind a router, forward this one too.
SRT_PORT=10890
#
# The TLS port the board is served on. The browser only grants WebGPU to a
# secure context, and the board's renderer needs it, so the board runs over
# HTTPS even on the LAN. Nothing is forwarded here from the router.
HTTPS_PORT=443
#
# Names and addresses the generated certificate covers, in openssl syntax, e.g.
# DNS:skylens.local,IP:10.9.8.37. Empty means this host's own hostname and
# addresses. Ignored once a certificate exists at /etc/skylens/tls/.
TLS_NAMES=
#
# yes sends a plain-HTTP request for a page to the TLS port. Set it to no to
# keep http working as-is, e.g. when the viewers launch Chrome with
# --unsafely-treat-insecure-origin-as-secure instead.
REDIRECT_TO_HTTPS=yes
#
# The control tower on this host, for the operator LAN and the VPN only. The
# core in Daejeon serves the tower itself; nginx reaches it over the same tunnel
# the board uses. The router forwards nothing to these ports, and only the
# ranges in TOWER_ALLOW are let in (nginx reads them in order, deny last).
TOWER_PORT=8090
TOWER_TLS_PORT=8091
TOWER_ALLOW="127.0.0.1 10.9.8.0/24 10.9.9.0/24"
#
# Where the live video comes from.
#   ingest  the drones publish SRT here and Daejeon pulls it (the design)
#   relay   Daejeon holds the video and this host pulls it over the tunnel as
#           RTSP, then sends WebRTC to the LAN. Needed because Daejeon's UDP
#           media does not cross the VPN and KOREN boundary: the signalling
#           answers and the screen still shows NO SIGNAL. Requires rtsp on the
#           Daejeon MediaMTX (loopback) and permitopen 127.0.0.1:8554 on the
#           bridge key.
VIDEO_MODE=ingest
#
# Which MediaMTX nginx sends /live/ to: this host (local) or the Daejeon one
# through the tunnel (tunnel).
WHEP_SOURCE=local
#
# The WHEP port of this host's MediaMTX, and the addresses it offers as ICE
# candidates. Empty means this host's own IPv4 addresses.
WHEP_PORT=10889
WEBRTC_HOSTS=
#
# Where the board's static files live (nginx serves `/` from here).
# Copy the build output, status.html included, into it. The installer creates it.
WEB_DIR=/opt/skylens/web
#
# The Daejeon VM this host tunnels to. No reason to change these.
DAEJEON_HOST=116.89.187.181
DAEJEON_PORT=26022
DAEJEON_USER=ubuntu
#
# MediaMTX version, pinned to the same one Daejeon runs.
MEDIAMTX_VERSION=v1.21.0
