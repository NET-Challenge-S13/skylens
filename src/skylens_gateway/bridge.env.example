# bridge.env 로 복사해서 값을 채운다. 비워두면 기본값.
#
# 브라우저가 접속할 HTTP 포트 (nginx). 80 이 다른 서비스에 쓰이면 바꾼다.
HTTP_PORT=80
#
# 드론 게이트웨이가 SRT 로 영상을 밀어넣을 때 쓰는 비밀번호.
# 비워두면 설치 시 무작위로 만들고 화면에 출력한다.
PUBLISH_PASS=
#
# SRT 수신 포트 (UDP). 공유기 뒤면 이 포트를 포트포워딩해야 한다.
SRT_PORT=10890
#
# 대전 VM — 이 서버가 SSH 터널을 걸어가는 곳. 바꿀 일 없음.
DAEJEON_HOST=116.89.187.181
DAEJEON_PORT=26022
DAEJEON_USER=ubuntu
#
# MediaMTX 버전 (대전과 동일하게 고정)
MEDIAMTX_VERSION=v1.21.0
