# Copy to bridge.env and fill in. Empty means the default.
#
# The HTTP port browsers connect to (nginx). Change it if 80 is taken.
HTTP_PORT=80
#
# The password the drone gateway uses to publish its SRT feed.
# Left empty, the installer makes a random one and prints it.
PUBLISH_PASS=
#
# SRT ingest port (UDP). Behind a router, forward this one too.
SRT_PORT=10890
#
# Where the board's static files live (nginx serves `/` from here).
# Copy the build output, status.html included, into it. The installer creates it.
WEB_DIR=/opt/skylens/web
#
# The Daejeon VM this host tunnels to. No reason to change these.
DAEJEON_HOST=116.89.187.181
DAEJEON_PORT=26022
DAEJEON_USER=ubuntu
#
# MediaMTX version, pinned to the same one Daejeon runs.
MEDIAMTX_VERSION=v1.21.0
