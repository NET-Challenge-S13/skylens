# Copy only the values you need into your shell or a local launch script.
# Do not commit the real Lito X1 template KMZ: it may contain aircraft/account metadata.

SKYLENS_DJI_TEMPLATE_KMZ=config/lito-x1-template.kmz
SKYLENS_MISSION_HOST=127.0.0.1
SKYLENS_MISSION_PORT=8091
SKYLENS_MISSION_OUTPUT=output/missions

# Optional: one exact DJI Fly placeholder KMZ to replace. The bridge backs it up
# before every overwrite. Leave empty for download-only mode (recommended first).
# SKYLENS_DJI_INSTALL_TARGET=/exact/mounted/path/to/DJI/placeholder.kmz

# Add the actual control-tower origin if it is not one of the localhost defaults.
# SKYLENS_MISSION_ALLOWED_ORIGINS=http://192.168.0.10:5173

# ── DJI cloud delivery (optional) ────────────────────────────────────────
# Lets the bridge push a mission to the DJI Fly account cloud so a remote RC 2
# pulls it over the air (POST /missions with "deliver": "cloud"). Both values
# are account/app secrets: keep them in your local env ONLY, never commit them.
# Without both set, cloud delivery stays disabled and download/install still work.
#
# SKYLENS_DJI_MC_TOKEN : the x-mc-token of a logged-in DJI Fly session (expires;
#                        re-extract when uploads start returning auth errors).
# SKYLENS_DJI_WK_KEY   : the HMAC signing key for X-Wk-SecretId=uav.
# SKYLENS_DJI_WK_SECRETID : defaults to "uav" (change only if DJI changes it).
# SKYLENS_DJI_APP_INFO    : x-app-info string; any plausible value works.
#
# SKYLENS_DJI_MC_TOKEN=paste-your-account-token-here
# SKYLENS_DJI_WK_KEY=paste-the-uav-signing-key-here
# SKYLENS_DJI_WK_SECRETID=uav
# SKYLENS_DJI_APP_INFO=Android-SkyLens-13-KR
#
# Token auto-refresh: point the bridge at a file that an external refresher
# keeps up to date (scripts/dji_token_refresh.py). The bridge re-reads it on
# every request and retries once on an auth error, so a refreshed token takes
# effect without a restart. When set, it overrides SKYLENS_DJI_MC_TOKEN while it
# has content. The file is gitignored.
# SKYLENS_DJI_TOKEN_FILE=output/.dji_token
#
# WSA-less PCs: run the token server on ONE rig machine that has WSA
# (`python scripts/dji_token_refresh.py --serve 8077`) and point every other PC
# here. Those PCs then need NO WSA and no device; they fetch the current token
# over HTTP and re-fetch on an auth error. Keep it on a trusted LAN (the token is
# a credential). Priority: URL, then FILE, then the static token above.
# SKYLENS_DJI_TOKEN_URL=http://<rig-ip>:8077/
